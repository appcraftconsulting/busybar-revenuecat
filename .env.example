# RevenueCat — create a v2 secret key in Dashboard → Project Settings → API Keys
# with permissions: charts_metrics:overview:read + charts_metrics:charts:read
RC_PROJECT_ID=
RC_API_KEY=sk_...
RC_CURRENCY=USD
# Chart used for "users today": customers_new (default) or customers_active
RC_USERS_CHART=customers_new

# BUSY Bar connection (pick one)
# USB (default, no auth):
BUSY_ADDR=10.0.4.20
# Wi-Fi LAN: set the bar's IP + the HTTP access password (enable in BUSY app)
#BUSY_ADDR=192.168.1.x
#BUSY_PASSWORD=
# Cloud: token from cloud.busy.app/api-tokens
#BUSY_ADDR=api.busy.app
#BUSY_TOKEN=

# Purchase event stream: RTDB path written by the busybarRevenueCatWebhook
# Cloud Function (RevenueCat webhook relay). Purchases push over SSE — no polling.
RC_EVENTS_URL=https://acc-drylendar-default-rtdb.firebaseio.com/busybar/<channel>/latest.json

# Purchase sound: a stock path on the bar, e.g. shared/sounds/alert.snd.
# Leave empty to auto-discover (run `node revbar.mjs sounds` to see what's available).
BUSY_SOUND=

# Tuning (defaults shown)
#BUSY_PRIORITY=30          # 10+ overrides built-in apps; <90 yields to focus sessions
#CYCLE_SECONDS=6           # per-metric screen time
#REVENUE_POLL_SECONDS=25   # purchase-detection poll (rate limit: 25 req/min shared)
#SLOW_POLL_SECONDS=120     # MRR + users-today refresh
#RB_DEBUG=1                # verbose API logging
