# Copied to functions/.env at setup (gitignored). These are non-secret
# deploy-time parameters; API keys/tokens live in Secret Manager instead.

# The RevenueCat project to display — the id from your dashboard URL:
# app.revenuecat.com/projects/<RC_PROJECT_ID>/...
# To switch projects: change this (and BUSYBAR_RC_KEY, which is project-scoped),
# then redeploy.
RC_PROJECT_ID=

RC_CURRENCY=USD
# Chart behind "USERS TODAY": customers_active (daily actives) or customers_new
RC_USERS_CHART=customers_active

BUSY_APP_NAME=revenuecat
# 10+ overrides the bar's built-in apps, <90 yields to a focus session
BUSY_PRIORITY=30
# Stock sound played on each purchase (list yours with: node revbar.mjs sounds)
BUSY_SOUND=shared/sounds/calendar_event_starts.snd
